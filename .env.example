# ---------------------------------------------------------------
# TEMPLATE for your settings file.
#   1. Copy this file to a new file named ".env"   (same folder)
#   2. Replace the placeholder values below with your own
#   3. NEVER share, commit or paste ".env" anywhere (it holds a secret)
# Lines starting with # are comments and are ignored.
# Write values as KEY=value with no quotes and no spaces around "=".
# ---------------------------------------------------------------

# Your Claude Platform on AWS API key.
# Generate it in the AWS Console under: Claude Platform on AWS -> API keys.
# A key made at console.anthropic.com will NOT work here.
# Short-lived keys expire after 12 hours: when you get an authentication
# error, generate a new one, paste it here and restart the program.
ANTHROPIC_AWS_API_KEY=paste-your-key-here

# Your workspace ID. It starts with "wrkspc_" (example: wrkspc_01AbCdEf23GhIj).
# Find it in the same Claude Platform on AWS area of the AWS Console.
ANTHROPIC_AWS_WORKSPACE_ID=wrkspc_paste-your-workspace-id-here

# The AWS region your workspace was created in (example: us-west-2).
# A workspace belongs to one region, so a wrong region will fail.
AWS_REGION=us-west-2
